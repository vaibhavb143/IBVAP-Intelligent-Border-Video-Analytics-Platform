# IBVAP Environment Variables Configuration Template
# Copy this file to .env for local development

# Security
SECRET_KEY=django-insecure-ibvap-sih-demo-key-replace-in-production-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database (Leave blank to use default SQLite3, or provide PostgreSQL URI for Render)
DATABASE_URL=

# Application Identity
APP_NAME="IBVAP — Intelligent Border Video Analytics Platform"
APP_ENV=development
